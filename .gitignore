# Dependencies
node_modules/
npm-debug.log*

# Environment Secrets (Never commit credentials to GitHub)
.env
.env.local
.env.production

# Database Runtime Files (SQLite DB created dynamically on startup)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
*.sqlite
*.db

# Temporary MS Office & OS Files
~$*
.DS_Store
Thumbs.db
*.tmp

# Editor Directories
.vscode/
.idea/

# Reference & Non-Required Development Files (Excluded from GitHub & Render)
not-required/
*.xlsm
