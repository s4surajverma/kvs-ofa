NODE_ENV=development
PORT=8080

# Supabase PostgreSQL connection string (used for both local dev and production)
# Find this in: Supabase Dashboard -> Project -> Settings -> Database -> Connection string -> URI
# Use the Pooler URL (port 6543) for best compatibility:
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

JWT_SECRET=your-jwt-secret-key-change-in-production
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=admin123
